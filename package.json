{
  "name": "kosha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kosha: fee collection and reconciliation ledger for an Indian college",
  "scripts": {
    "dev": "node --max-http-header-size=65536 node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --max-http-header-size=65536 node_modules/next/dist/bin/next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "db:setup": "tsx scripts/db-setup.ts setup",
    "db:reset": "tsx scripts/db-setup.ts reset",
    "db:verify": "tsx scripts/db-setup.ts verify",
    "db:sample": "tsx scripts/make-settlement-sample.ts",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "papaparse": "^5.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "mermaid": "^12.0.0",
    "pg": "^8.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
